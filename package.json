{
  "name": "dsh-plugin-side-chat",
  "version": "1.0.0",
  "type": "module",
  "description": "Temporary side conversation in the right sidebar with three modes (reply only / read-only / fully inherited), rendering the same chat UI as the main conversation.",
  "license": "MIT",
  "author": "Aixineiar (https://github.com/Aixineiar)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "side-chat",
    "sidebar",
    "read-only",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aixineiar/dsh-side-chat.git"
  },
  "homepage": "https://github.com/Aixineiar/dsh-side-chat#readme",
  "bugs": {
    "url": "https://github.com/Aixineiar/dsh-side-chat/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node dev/boot-sim.mjs",
    "dev:boot-sim": "node dev/boot-sim.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    "index.js",
    "prompt.js",
    "seed.js",
    "tools.js",
    "routes.js",
    "lifecycle.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-subagent",
        "@deepseek-ai/dsh-client-resources"
      ]
    }
  }
}
